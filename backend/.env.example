# Copiar a .env y completar. NO commitear el .env real (tiene secretos).

# Base de datos del sistema nuevo (PostgreSQL)
DATABASE_URL=postgres://usuario:clave@localhost:5432/ventaspro_nuevo

# API Tango V2 (la API Key está en la doc confidencial / .env de Tango)
TANGO_API_BASE_URL=https://tango-pr.com
TANGO_API_KEY=tk_xxx_pega_la_clave_aca

# Secreto para firmar las sesiones del CRM (poné algo largo y random)
JWT_SECRET=cambia_esto_por_algo_largo_y_random

PORT=4000

# Google Places API Key
GOOGLE_PLACES_API_KEY=tu_clave_de_api_de_google_maps_aqui

# SMTP / Office365 para "Enviar por servidor (SMTP)"
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=tu_correo@dominio.com
SMTP_PASS=tu_password_o_app_password
# Tambien se acepta SMTP_PASSWORD en lugar de SMTP_PASS.
SMTP_FROM=tu_correo@dominio.com

# Archivos oficiales archivados por el motor de ofertas.
MOTOR_OFERTAS_UPLOAD_DIR=./uploads/motor-ofertas
